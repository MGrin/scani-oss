{
  "name": "@scani/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "bun scripts/run.ts",
    "test:e2e:ui": "bun scripts/run.ts --ui",
    "test:e2e:a11y": "bun scripts/run.ts tests/a11y tests/smoke --project chromium --project iphone",
    "test:e2e:install": "bunx playwright install --with-deps chromium webkit",
    "shots": "bun scripts/shots.ts",
    "visual": "bun scripts/visual.ts",
    "perf:tti": "bun scripts/measure-bundle-tti.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsgo --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@types/bun": "latest",
    "ioredis": "^5.10.1"
  }
}
