{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The repo root, not this workspace: `scripts/run.ts` derives its compose
    // project name from `scripts/lib/worktree.ts`, which is the one place a
    // checkout's identity is decided (SC-493). Nothing is emitted here, so
    // `rootDir` only decides which files the program is allowed to reach.
    "rootDir": "../..",
    "noEmit": true,
    // `page.evaluate` callbacks are compiled here and executed in the browser,
    // so `document`, `Element` and `getComputedStyle` have to resolve — the
    // accessibility fixture measures the rendered tree from inside the page.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@playwright/test", "bun"]
  },
  "include": [
    "tests/**/*",
    "capture/**/*",
    "fixtures/**/*",
    "scripts/**/*",
    "unit/**/*",
    "visual/**/*",
    "playwright.config.ts",
    "playwright.shots.config.ts",
    "playwright.visual.config.ts"
  ]
}
