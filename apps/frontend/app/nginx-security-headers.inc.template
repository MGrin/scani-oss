# The security-header set for the self-hosted SPA, in one place.
#
# nginx's `add_header` inheritance is REPLACE, not merge: a `location`
# that declares any `add_header` of its own discards every header
# inherited from its parent. So this file cannot live at `server` level
# and be relied upon — it has to be `include`d into each location that
# carries an `add_header`. `nginx.conf.template` does that, and a test
# fails the build if a location grows an `add_header` without it.
#
# `public/_headers` declares the same policy for static hosts that read
# that format (Cloudflare Pages, Netlify). nginx does not read it, which
# is why this file exists — see SC-561. The two are kept in step by
# `tests/public/security-headers.test.ts`.
#
# `${CSP_CONNECT_SRC}` is expanded by the nginx image's envsubst at
# container start, the same mechanism `${API_UPSTREAM}` already uses. The
# Dockerfile defaults it to `'self'`, which is correct for the compose
# topology: the bundle is built with `VITE_API_URL=/api`, so the browser
# only ever talks to its own origin. An operator serving the SPA and the
# API from different origins widens it deliberately rather than turning
# the header off.

add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src ${CSP_CONNECT_SRC}; font-src 'self' data:; frame-ancestors 'none'; form-action 'self'; object-src 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header Cross-Origin-Resource-Policy "same-site" always;

# Don't index the SPA — only the SSR landing page would.
#
# `${ROBOTS_DIRECTIVE}` is expanded by the same envsubst that fills
# `${CSP_CONNECT_SRC}` above, and it is DERIVED rather than set: the
# Dockerfile defaults it to `noindex, nofollow`, and
# `docker-robots-policy.envsh` overwrites it from `ROBOTS_POLICY` on every
# boot. That indirection exists because a crawler takes the most restrictive
# of the header, the `<meta name="robots">` in `index.html` and
# `robots.txt` — so a header that could be flipped on its own would buy an
# operator nothing but the belief that they had flipped something. One knob
# moves all three; see that file. The sentence this replaces told a
# self-hoster who wanted indexing to layer their own front-of-stack, which
# was the honest advice while there was no knob to offer them.
add_header X-Robots-Tag "${ROBOTS_DIRECTIVE}" always;
