# nginx site config for the frontend SPA. Run through envsubst at
# container boot — `${API_UPSTREAM}` and `${CSP_CONNECT_SRC}` are
# expanded from the env vars of the same name.

# The X-Robots-Tag a response carries, scoped the way `robots.txt` is
# (SC-1111). `ROBOTS_POLICY` is still the one knob and still moves all three
# mechanisms together; this only stops the header claiming more than the
# policy grants. Under `index-root` the root document is offered and nothing
# else is — `robots.txt` says so with an anchored `Allow: /$`, and until this
# map the header said `index, follow` on every deep route and every invented
# path, contradicting it. Under `noindex` both arms resolve to the same value.
#
# `$request_uri` and not `$uri`: `/` reaches the document through an internal
# redirect to `/index.html`, which rewrites `$uri` but not the request line. A
# direct `/index.html` is the same document at a second address, so it is not
# offered.
map $request_uri $robots_tag {
    default             "noindex, nofollow";
    "~^/(\?.*)?$"       "${ROBOTS_DIRECTIVE}";
}

# Realtime is a WebSocket on the api's root, which is `/api/` from here
# (SC-1542). `Connection` has to be `upgrade` for the handshake and empty for
# everything else, so upstream keepalive is not turned off for plain requests.
map $http_upgrade $connection_upgrade {
    default  upgrade;
    ''       '';
}

# A hashed asset is immutable; its absence is not (SC-1318). Keyed on the
# status because `add_header … always` is the only way a 404 carries a header,
# and one `Cache-Control` per response has to cover both.
map $status $asset_cache_control {
    default  "no-store";
    200      "public, max-age=31536000, immutable";
    304      "public, max-age=31536000, immutable";
}

server {
    listen       80 default_server;
    listen       [::]:80 default_server;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Disable nginx's "Server: nginx/x.y.z" header — small information
    # leak that adds nothing for the operator.
    server_tokens off;

    # The security headers live in one included file and are repeated into
    # every location below that declares an `add_header` of its own.
    #
    # That repetition is not redundancy. nginx's `add_header` inheritance
    # is REPLACE, not merge: the moment a location declares any header,
    # it drops every header inherited from its parent — silently, with a
    # config that still passes `nginx -t`. Before SC-561 this file set
    # `X-Robots-Tag` here at server level and nowhere else, and it reached
    # `/version.json` and no HTML response at all, because `location /`'s
    # children each set their own `Cache-Control`. The one header whose
    # job is "do not index the SPA" was absent from exactly the responses
    # a crawler indexes.
    #
    # `tests/public/security-headers.test.ts` fails the build if a
    # location grows an `add_header` without the include beside it.
    include /etc/nginx/conf.d/security-headers.inc;

    # A missing hashed file is a 404, never the SPA shell (SC-1318). `^~` wins
    # over the extension regex below, so every `/assets/` path lands here —
    # the regex only 404'd the extensions it lists, and the shell answered the
    # rest with a year-long header a browser keeps under the asset's name.
    location ^~ /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control $asset_cache_control always;
        try_files $uri =404;
    }

    # SPA history routing — any path that doesn't match a real file
    # falls back to index.html so React Router takes over.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri $uri/ /index.html;

        # Aggressive caching for hashed assets, none for index.html so
        # deploys are picked up on the next page load.
        location ~* \.(?:js|css|woff2?|ttf|eot|otf|svg|png|jpg|jpeg|gif|ico|webp|avif)$ {
            include /etc/nginx/conf.d/security-headers.inc;
            expires 1y;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        location = /index.html {
            include /etc/nginx/conf.d/security-headers.inc;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            expires 0;
        }
    }

    # `_headers` is the Cloudflare Pages / Netlify source for the same
    # policy this server config applies. nginx never reads it, so serving
    # it would publish a config file describing rules this deployment does
    # not get from it. The Dockerfile deletes it from the image; this is
    # the belt for anyone mounting a `dist/` built elsewhere.
    location = /_headers {
        include /etc/nginx/conf.d/security-headers.inc;
        return 404;
    }

    # Better-Auth, passed through WITH its prefix. The api mounts it at
    # /api/auth/*, and the magic-link email embeds BACKEND_URL — this
    # origin, no path — so the link arrives here as /api/auth/... too. The
    # /api/ block below strips its prefix and would hand the api
    # /auth/..., which it does not serve: every sign-in 404'd (SC-1520).
    location /api/auth/ {
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass         ${API_UPSTREAM}/api/auth/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Scani-Forwarded-Client-IP $http_fly_client_ip;
        proxy_set_header   Connection        "";
        proxy_redirect     off;
    }

    # The realtime WebSocket. The app opens it at the api base itself, so it
    # arrives as exactly `/api/` and reaches the api's root, where Elysia
    # upgrades it. The prefix block below clears `Connection`, which turned
    # every handshake into a plain 200 and left realtime disconnected on the
    # published image (SC-1542). Same exemption from the security-header
    # include as that block, for the same reason.
    location = /api/ {
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass         ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Scani-Forwarded-Client-IP $http_fly_client_ip;
        proxy_redirect     off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Reverse-proxy /api/* to the backend service. The trailing slash on
    # both sides strips /api before forwarding (so the api itself sees
    # the un-prefixed path it knows about).
    #
    # Deliberately NOT carrying the security-header include: the api sets
    # its own CSP, X-Frame-Options and X-Content-Type-Options
    # (`apps/backend/api/src/index.ts`), and a second Content-Security-Policy
    # on the same response is intersected by the browser rather than
    # replaced. `X-Robots-Tag` is repeated by hand so proxied responses
    # keep the one header the api does not set.
    location /api/ {
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass         ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # On Fly the proxy in front of this server names the visitor in
        # Fly-Client-IP. A second Fly proxy hop on the way to the api (flycast)
        # replaces that header with this machine's address, so the visitor is
        # repeated under a name it leaves alone; the api reads it only from a
        # private-network caller (SC-1495). Unset when the header is absent.
        proxy_set_header   X-Scani-Forwarded-Client-IP $http_fly_client_ip;
        proxy_set_header   Connection        "";
        # Magic-link emails embed BACKEND_URL — keep redirects passing
        # back unchanged so the browser lands on the right host.
        proxy_redirect     off;
        # tRPC mutations can carry largish JSON bodies (file imports,
        # screenshot OCR results) — give them headroom.
        client_max_body_size 25m;
        proxy_read_timeout   90s;
    }

    # Container-level health probe — returns the SPA index so any HTTP
    # client (including the Dockerfile's HEALTHCHECK) gets a 200.
    location = /healthz {
        include /etc/nginx/conf.d/security-headers.inc;
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
