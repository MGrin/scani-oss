# Backend environment variables — the source of truth for which variables
# this app reads. `scripts/sync-env.ts` uses every key listed below (active
# or commented) as an allowlist: for each key it finds, it copies the value
# from the root `.env` into `apps/backend/api/.env`.
#
# To add a new variable: drop it into this file (commented is fine if
# optional) and re-run `bun run env:sync`.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
SCANI_DEPLOYMENT_TIER=1
SERVICE_NAME=api
PORT=3001
HOST=localhost

# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://scani:scani@localhost:5433/scani?sslmode=disable
REDIS_URL=redis://localhost:6380

# -----------------------------------------------------------------------------
# Public URLs + auth
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
BETTER_AUTH_SECRET=dev_secret_change_me_this_is_not_production_safe
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
JOBS_HMAC_SECRET=dev_jobs_hmac_change_me_not_prod_safe
# COOKIE_DOMAIN=.your-domain.example.com   # production only

# -----------------------------------------------------------------------------
# Email — Mailpit in dev, SMTP or Fastmail JMAP in prod
# -----------------------------------------------------------------------------
SMTP_URL=smtp://localhost:1026
SMTP_FROM=no-reply@scani.local
# FASTMAIL_API_TOKEN=

# -----------------------------------------------------------------------------
# Platform processing — selected by SCANI_DEPLOYMENT_TIER
# -----------------------------------------------------------------------------
# Tier 1 uses the local data-provider and direct platform providers.
# Tier 2 uses https://api.cloud.scani.xyz and one Scani Cloud key.
# Both tiers keep S3 and the database under your control.
SCANI_CLOUD_URL=http://localhost:8082
SCANI_CLOUD_API_KEY=dev_data_provider_key_change_me_not_prod_safe

# -----------------------------------------------------------------------------
# Platform keys — Tier 1 only. Tier 2 sends platform requests to Scani Cloud
# using SCANI_CLOUD_API_KEY; no OpenAI, pricing or public-chain keys are needed.
# Personal exchange/broker credentials remain local in both tiers.
# OPENAI_API_KEY=
# COINGECKO_API_KEY=
# FINNHUB_API_KEY=
# ETHERSCAN_API_KEY=
# HELIUS_API_KEY=
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY=

# -----------------------------------------------------------------------------
# Object storage (SeaweedFS in dev, any S3-compatible store in prod)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=scani-dev
S3_SECRET_ACCESS_KEY=scani-dev-secret
S3_BUCKET=job-uploads-dev

# -----------------------------------------------------------------------------
# Logging + Sentry
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_SQL_QUERIES=false
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Optional: 32+ character bearer for detailed health diagnostics.
# DIAGNOSTICS_TOKEN=
# Optional Turnstile verification; configure the frontend site key first.
# TURNSTILE_SECRET=
