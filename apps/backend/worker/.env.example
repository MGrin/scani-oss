# Worker environment variables — source of truth for which variables this
# app reads. `scripts/sync-env.ts` treats every key listed below as an
# allowlist: it copies values from root `.env` into `apps/worker/.env`.
#
# ENCRYPTION_KEY must match the backend's byte-for-byte, otherwise stored
# integration credentials can't be decrypted at job time.

NODE_ENV=development
SCANI_DEPLOYMENT_TIER=1
SERVICE_NAME=worker

DATABASE_URL=postgres://scani:scani@localhost:5433/scani?sslmode=disable
REDIS_URL=redis://localhost:6380

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
WORKER_CONCURRENCY=4

# Tier 1 uses local/direct providers. Tier 2 uses https://api.cloud.scani.xyz
# and one Scani Cloud key for platform processing; S3 remains local.
SCANI_CLOUD_URL=http://localhost:8082
SCANI_CLOUD_API_KEY=dev_data_provider_key_change_me_not_prod_safe

# Platform keys — Tier 1 only. Tier 2 sends platform requests to Scani Cloud
# using SCANI_CLOUD_API_KEY; no OpenAI, pricing or public-chain keys are needed.
# Personal exchange/broker credentials remain local in both tiers.
# OPENAI_API_KEY=
# COINGECKO_API_KEY=
# FINNHUB_API_KEY=
# ETHERSCAN_API_KEY=
# HELIUS_API_KEY=
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY=

# Object storage (SeaweedFS in dev, any S3-compatible store in prod).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=scani-dev
S3_SECRET_ACCESS_KEY=scani-dev-secret
S3_BUCKET=job-uploads-dev

# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
