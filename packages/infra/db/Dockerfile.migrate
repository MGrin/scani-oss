# syntax=docker/dockerfile:1.7-labs
#
# Tiny single-purpose image for applying migrations against a running
# Postgres — BOTH the application schema (Drizzle) and BullMQ's queue
# schema (SC-535). Self-hosters run it as a one-shot before bringing the
# app stack up (or as an opt-in `--profile migrate` service in
# docker-compose.prod.yml).
#
# Build pattern matches api / worker / data-provider: bun build --compile
# produces a single self-contained binary in the build stage; the runtime
# stage is debian:bookworm-slim + ca-certs + the binary + the two SQL
# folders the binary reads at runtime. No bun runtime and no `packages/`
# tree at runtime — image lands well under 100 MB instead of the prior
# ~500 MB. The only thing under `node_modules/` at runtime is bullmq's
# migration SQL, which its loader insists on reading from that exact path.
#
# Migrations live OUTSIDE the api/worker/data-provider runtime images by
# design — the OSS distribution treats schema changes as an operator
# concern, matching the dev-compose pattern (one-shot migrate container)
# and the managed-deploy pattern (CI runs migrations as a separate deploy
# step).
#
# The migrator refuses any target that is not loopback unless the caller
# names that target's hostname on the command line — see the gate in
# `src/migrate.ts`. In a container the database is essentially never on
# loopback, so the host is passed explicitly below.
#
# Usage (standalone):
#   docker run --rm -e DATABASE_URL=postgres://…@db.example.com/scani \
#     scani/migrate:latest /app/migrate --allow-remote db.example.com
#
# Usage (docker-compose.prod.yml):
#   docker compose -f docker-compose.prod.yml --profile migrate run --rm migrate

ARG BUN_VERSION=1.4.2

# ---------- deps ----------
FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /app

# `--parents` preserves directory structure under the glob, so the
# workspace registration that `bun install --filter` requires stays
# correct without enumerating every package.json by hand.
COPY package.json bun.lock ./
# `patchedDependencies` in package.json points here; install fails without it.
COPY patches ./patches
COPY --parents apps/*/package.json apps/*/*/package.json packages/*/*/package.json ./

# Filter to the dep graphs of the two workspaces the entrypoint imports —
# drops everything reachable only through other workspaces (the bulk of the
# monorepo).
#
# SC-535: `@scani/queue` is here because the migrator applies BullMQ's queue
# schema as well as the application one. Dropping it is what made the shipped
# image the one caller that never created the `bullmq` schema, so a
# self-hoster's first enqueue returned 500.
RUN bun install --frozen-lockfile \
    --filter @scani/db --filter @scani/queue --linker=hoisted

# ---------- build ----------
FROM oven/bun:${BUN_VERSION} AS build
WORKDIR /app

# NODE_ENV is intentionally NOT set at build time — same reasoning as the
# api/worker/data-provider Dockerfiles. See `@scani/config`'s getNodeEnv
# helper for the inlining trap that motivates the runtime-only read.

COPY --from=deps /app/node_modules ./node_modules
COPY package.json bun.lock tsconfig.json ./
COPY packages ./packages
COPY scripts/migrate.ts ./scripts/migrate.ts

# SC-535. The entrypoint is `scripts/migrate.ts`, the SAME one `bun run
# db:migrate` runs — not `@scani/db`'s Drizzle migrator. That migrator applies
# the application schema alone, so compiling it here made this image the only
# migrator in the repo that never created BullMQ's `bullmq` schema. It is also
# the only migrator a self-hoster ever runs.
RUN bun build scripts/migrate.ts \
    --compile \
    --target=bun \
    --minify \
    --outfile=dist/migrate

# SC-535, and SC-518 before it in the api and worker images. BullMQ 6.2's
# Postgres migrator read its schema SQL with `readFileSync` at RUNTIME, which
# `bun build --compile` does not bundle, so this image used to copy the .sql
# files beside the binary. 6.3 inlines them into `sql-scripts.js`
# (taskforcesh/bullmq#4603) and ships no .sql files at all (SC-1677).
#
# THIS ASSERTION IS STILL A CONDITION. Without the schema SQL this binary
# cannot create the queue schema, from an image that builds cleanly. So assert
# the loader reads no file, and that the compiled binary itself carries the
# 0001_schema SQL. A release that goes back to reading files fails here.
RUN grep -q "from './sql-scripts'" node_modules/bullmq/dist/esm/postgres/sql-loader.js \
    && ! grep -q readFileSync node_modules/bullmq/dist/esm/postgres/sql-loader.js \
    && grep -q 'CREATE TABLE job_dependency (' dist/migrate \
    || (echo "SC-535: the compiled binary does not carry bullmq's migration SQL — it cannot create the queue schema" && exit 1)

# ---------- runtime ----------
FROM debian:bookworm-slim AS runtime
WORKDIR /app

# ca-certificates: TLS to managed-Postgres (Neon, RDS, Supabase, …).
# No curl — the migrate container is a one-shot that exits on success.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Non-root user. The runner only needs read on its own files +
# network egress to Postgres; no filesystem writes outside /tmp.
RUN useradd --create-home --shell /usr/sbin/nologin --uid 1001 app
USER app

# The compiled binary + the SQL migration files. `bun --compile` embeds
# the TypeScript module graph but NOT arbitrary files; migrate.ts joins
# `__dirname/migrations` at runtime, so the SQL folder must sit next to
# the binary on disk. With this layout `__dirname` resolves to `/app`
# inside the compiled binary, matching the `/app/migrations` path below.
COPY --from=build --chown=app:app /app/dist/migrate /app/migrate
COPY --chown=app:app packages/infra/db/src/migrations /app/migrations

CMD ["/app/migrate"]
