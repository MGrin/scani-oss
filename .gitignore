# dependencies (bun install)
node_modules

# output
out
dist
*.tgz

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store


**/*.api-key.json

# Claude Code local state (worktrees, scheduled-task locks, etc.).
# Nothing under this directory is source — it's all per-checkout tooling
# artifacts that would pollute the repo if committed.
.claude/

# Local Docker Compose overrides
docker-compose.override.yml

# Local scratch files
.local/


# Bun leaves a multi-megabyte intermediate here when `bun build --compile` is
# interrupted. One reached a branch once (SC-94); a 61 MB blob in git history is
# permanent and everyone pays to clone it forever.
*.bun-build

# Build output that lives beside the app or module producing it, and
# infrastructure working state (SC-569, SC-577).
#
# These belong here rather than in a per-directory `.gitignore` because a
# per-directory one is a TRACKED FILE: any checkout that does not include that
# directory deletes the rule while the artefacts stay on disk, and output that
# was ignored a moment ago becomes an ordinary untracked file the next
# `git add -A` will take. Measured once at eleven files, one of them Terraform
# state.
#
# GLOBS, never paths. A list of directories would be an inventory of what some
# other checkout of this tree contains, which is its own disclosure; `**/.next/`
# names nothing and covers every app that ever adds one.
**/.next/
**/.vercel/
**/.turbo/
**/.wrangler/
**/next-env.d.ts.bak
**/public/version.json

# Terraform working state. `*.tfstate` carries resource identifiers and, for
# several providers, credentials in plaintext.
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/tfplan
