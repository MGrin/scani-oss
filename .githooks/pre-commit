#!/usr/bin/env bash
# Pre-commit hook: lint + type-check + syncpack.
#
# Installed automatically by the `prepare` script in the root package.json
# (runs `git config core.hooksPath .githooks` on `bun install`).
#
# Skip with `git commit --no-verify` — but NOT mid-merge, where it commits
# conflict markers and clears MERGE_HEAD (SC-715). `fail` below says so at the
# moment it matters, because a caution in a header nobody opens is not one.

set -eu

# Make sure common tool locations are on PATH for GUI git clients (IDEs,
# Fork, Tower) that don't inherit a full shell environment.
export PATH="$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RESET=$'\033[0m'

# A refusal that names a way around itself gets taken (SC-639), so the way it
# names has to be safe in the state the refusal happened in. Mid-merge it is
# not: `--no-verify` commits WHATEVER IS STAGED, and mid-merge that routinely
# means conflict markers. Measured 2026-08-27 (SC-715): following this advice
# during a conflicted merge produces a real merge commit whose file contains
# `<<<<<<< HEAD`, after which MERGE_HEAD is gone and git no longer considers a
# merge to be in progress — so nothing downstream flags it either.
#
# MERGE_HEAD is still present when this hook runs, which is what makes the
# distinction available at all. Measured the same day: a hook-refused merge
# commit leaves MERGE_HEAD in place, because the commit never happened.
fail() {
  echo "${RED}✗ pre-commit failed:${RESET} $1" >&2
  if [ -e "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null || echo /nonexistent)" ]; then
    echo "  You are MID-MERGE, so do not reach for \`--no-verify\` here: it would commit" >&2
    echo "  whatever is staged, conflict markers included, and git would then stop" >&2
    echo "  considering a merge to be in progress." >&2
    echo "  Find them:  git diff --cached -U0 | grep -n '^+<<<<<<<'" >&2
    echo "  Resolve the conflict, re-stage, and commit again — or \`git merge --abort\`." >&2
  else
    echo "  Fix the issue and re-stage, or bypass with \`git commit --no-verify\`." >&2
  fi
  exit 1
}

note() {
  echo "${YELLOW}→ $1${RESET}"
}

ok() {
  echo "${GREEN}✓ $1${RESET}"
}

# Paths of staged (Added/Modified/Renamed/Copied) files — exclude Deleted.
staged_files() {
  git diff --cached --name-only --diff-filter=ACMR "$@"
}

# -------- 0. Nothing private may ride an scani-oss-bound commit --------
#
# SC-569. Checking out a public-mirror branch inside a private worktree deletes
# the per-app `.gitignore` files, because they are tracked private files — so
# local build output whose only ignore rule lived there stops being ignored and
# a `git add -A` a second later takes files that were untrackable a moment
# before. Measured: nine of them, several carrying deployment identity. The
# paths are in the private commit rather than here, for the same reason the
# guard exists.
#
# First, and before the expensive checks, so a refusal is immediate.
#
# It is a REFUSAL on any non-zero status, including the script's exit 9, which
# means it could not tell whether this branch is bound for the mirror. "Could
# not tell" costs one `git fetch upstream`; treating it as a pass is how a
# guard becomes decoration in the one state where it cannot see.
if [ -f scripts/check-oss-bound-paths.ts ]; then
  if ! bun scripts/check-oss-bound-paths.ts; then
    fail "staged paths that cannot travel to MGrin/scani-oss"
  fi
else
  # Says so rather than passing quietly: on a branch predating SC-569 the
  # check genuinely does not exist, and a silent skip reads like a clean run.
  note "scripts/check-oss-bound-paths.ts is not in this tree; OSS-boundary check NOT run"
fi

# -------- 0b. No test fixture may ride a commit --------
#
# SC-596. Two tests under scripts/tests/ write a fixture INSIDE the repo and
# record it with `git add -N`, because check-docs.ts only reads files git tracks
# (SC-430). Their `afterEach` removes it — and does not run when the process is
# killed, so a killed test run leaves the fixture in the INDEX, where the next
# `git add -A` takes it. One of them sits in the docs content root, so the site
# would build it as a page.
#
# The tests sweep stale fixtures at their own start, which repairs a corpse on
# the next run even if that run is killed too. This closes the window in
# between, which is where the damage happens: the contributor whose test run was
# killed commits before running another one.
if [ -f scripts/check-staged-test-fixtures.ts ]; then
  if ! bun scripts/check-staged-test-fixtures.ts; then
    fail "a scripts/tests fixture is staged — a killed run left it behind (SC-596)"
  fi
else
  note "scripts/check-staged-test-fixtures.ts is not in this tree; fixture check NOT run"
fi

# -------- 0c. Nothing internal may ride inside a file that legitimately travels --------
#
# SC-598. `check-oss-bound-paths.ts` above answers ROUTING — which files may go — and
# nothing about what is inside one that may. The hazard that leaves is an
# oss-eligible file, correctly pushed, whose COMMENTS carry an internal board
# key, an agent session id, an internal host or a machine-local path. That is
# not hypothetical: a mirror-bound draft carried a board key and two session
# ids, and the only thing between it and the public repo was somebody checking
# precedent by hand.
#
# It cannot be keyed on the classifier for the same two reasons that check
# cannot be, and one more of its own: the classifier is private-only, so
# from a mirror-bound checkout it does not run at all. This one has no private
# imports and answers in both repositories — including in scani-oss itself,
# where there is no `upstream` remote and every commit is public by definition.
#
# A REFUSAL on any non-zero status, exit 9 included, on the same reasoning:
# "could not tell which repo this is for" is not a pass.
if [ -f scripts/check-oss-internal-refs.ts ]; then
  if ! bun scripts/check-oss-internal-refs.ts; then
    fail "staged content carries references that cannot travel to MGrin/scani-oss"
  fi
else
  note "scripts/check-oss-internal-refs.ts is not in this tree; internal-reference check NOT run"
fi

# -------- 0d. No new production FIGURE may ride inside a file that travels --------
#
# SC-887. The check above reads what is inside a travelling file, and every
# rule it carries reads ZERO against this repository. A precise decimal cannot:
# there are 858 of them across 176 files here after exclusions, every one
# legitimate — a price formatter's test needs them, and so does a colour-space
# helper. So this check judges the FLOW instead, figures on ADDED lines only,
# and refuses until somebody says the number is synthetic.
#
# WHAT IT IS FOR. A precise decimal in a fixture is either invented or measured,
# and nothing about the text says which. A measured one is somebody's real
# account, and it has reached this repository that way before — inside a test
# fixture, in a file that was correctly public, caught by a person rather than
# by anything mechanical.
#
# STATED LIMIT, and it is half the hazard: this reads digits and cannot read
# PROSE. The refusal says so itself rather than leaving you to find out.
#
# A REFUSAL on any non-zero status, exit 9 and exit 10 included, on the same
# reasoning as the blocks above: "could not tell" and "the guard could not
# verify itself" are not passes.
if [ -f scripts/check-oss-figures.ts ]; then
  if ! bun scripts/check-oss-figures.ts; then
    fail "staged lines add figures precise enough to be measurements (SC-887)"
  fi
else
  note "scripts/check-oss-figures.ts is not in this tree; figure check NOT run"
fi

# -------- 0e. PROSE describing a deployment, on lines that travel --------
#
# SC-909. The check above reads decimal literals and says in its own header that
# it cannot read PROSE — and that limitation is reachable through the most
# ordinary route there is: writing a good comment explaining WHY a change
# exists, using the incident that motivated it. A draft carried an incident's
# evidence verbatim into code comments, a migration and a pull request body, and
# all four checks above passed it. Each was right to: routing was correct, the
# references were legitimate, and there was no precise decimal anywhere in it.
#
# A MIGRATION COMMENT IS THE URGENT ONE. `scripts/migrate.ts` refuses the whole
# run on sha256 drift, for an edited applied migration and for a deleted one,
# with no escape flag — so an applied migration's text is permanent, and there
# is no later at which a sentence in one gets fixed.
#
# READ THE INVERSION, BECAUSE EVERY BLOCK ABOVE IS THE OTHER WAY. Those four are
# a REFUSAL on any non-zero status, exit 9 and exit 10 included. This one NEVER
# fails the commit, on any status, and that is not an oversight:
#
#   It reports a SHAPE, not a defect. "This sentence is specific about a running
#   deployment and it is going public" is a true statement about text that a
#   person then has to judge. A false positive on prose is cheap to read past; a
#   false refusal on a good comment is what gets a guard switched off, and a
#   disabled guard is strictly worse than the gap it was closing.
#
#   There is consequently no escape variable, and nothing to disable.
#
#   Its own rot is caught where it belongs — `scripts/tests/check-oss-prose.test.ts`
#   asserts the self-test and the fixtures, so a signal that has stopped
#   matching fails CI rather than passing quietly here.
#
# `|| true` is deliberate and load-bearing: without it `set -eu` at the top of
# this file turns exit 9 or 10 into a refused commit, which is the posture this
# block exists to avoid.
if [ -f scripts/check-oss-prose.ts ]; then
  bun scripts/check-oss-prose.ts || true
else
  note "scripts/check-oss-prose.ts is not in this tree; deployment-prose check NOT run"
fi

# -------- 1. Biome lint (staged files only, fast) --------

biome_relevant=$(staged_files -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.jsonc' || true)
if [ -n "$biome_relevant" ]; then
  note "biome check --staged"
  if ! bunx --bun @biomejs/biome@2.4.12 check --staged --no-errors-on-unmatched; then
    fail "biome check reported errors"
  fi
  ok "biome clean"
else
  note "no lintable files staged; skipping biome"
fi

# -------- 2. TypeScript type-check (full monorepo) --------
#
# Only triggered when TS/TSX files changed; the graph-based check has to
# be whole-project, so there's no point running it for docs/infra-only
# commits.
ts_relevant=$(staged_files -- '*.ts' '*.tsx' || true)
if [ -n "$ts_relevant" ]; then
  note "bun run type-check (full monorepo)"
  if ! bun run type-check >/dev/null 2>&1; then
    echo "${RED}type-check output:${RESET}" >&2
    bun run type-check >&2 || true
    fail "type-check errors"
  fi
  ok "type-check clean"
else
  note "no TS files staged; skipping type-check"
fi

# -------- 3. Syncpack (only when any package.json is staged) --------
#
# Catches version drift across the workspace: if two package.json files
# ever declare different versions of the same external dependency,
# syncpack fails here instead of at install time.

pkg_staged=$(staged_files -- '**/package.json' 'package.json' || true)
if [ -n "$pkg_staged" ]; then
  note "syncpack lint"
  if ! bun run deps:lint >/dev/null 2>&1; then
    echo "${RED}syncpack output:${RESET}" >&2
    bun run deps:lint >&2 || true
    echo "  Run: bun run deps:fix && git add package.json **/package.json" >&2
    fail "workspace dependencies out of sync"
  fi
  ok "dependencies in sync"
fi

# -------- 5. CI per-package filter list in sync with workspaces --------
#
# Triggered when any workspace package.json or the codegen-managed CI
# workflow changed. The auto:filters block in `.github/workflows/ci.yml`
# is generated from `packages/*/*/package.json`; staging drift fails CI
# server-side, so catch it here. Also runs when the codegen script itself
# is touched.

ci_relevant=$(staged_files -- 'packages/*/*/package.json' '.github/workflows/ci.yml' 'scripts/generate-ci-filters.ts' || true)
if [ -n "$ci_relevant" ]; then
  note "ci:gen:check"
  if ! bun run ci:gen:check >/dev/null 2>&1; then
    echo "${RED}ci:gen:check output:${RESET}" >&2
    bun run ci:gen:check >&2 || true
    echo "  Run: bun run ci:gen && git add .github/workflows/ci.yml" >&2
    fail "CI filter list out of sync with packages/*/*"
  fi
  ok "CI filters in sync"
fi

echo "${GREEN}✓ pre-commit passed${RESET}"
