#!/usr/bin/env bash
# Pre-commit hook: lint + type-check + syncpack.
#
# Installed automatically by the `prepare` script in the root package.json
# (runs `git config core.hooksPath .githooks` on `bun install`).
#
# Skip with `git commit --no-verify`.

set -eu

# Make sure common tool locations are on PATH for GUI git clients (IDEs,
# Fork, Tower) that don't inherit a full shell environment.
export PATH="$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RESET=$'\033[0m'

fail() {
  echo "${RED}✗ pre-commit failed:${RESET} $1" >&2
  echo "  Fix the issue and re-stage, or bypass with \`git commit --no-verify\`." >&2
  exit 1
}

note() {
  echo "${YELLOW}→ $1${RESET}"
}

ok() {
  echo "${GREEN}✓ $1${RESET}"
}

# Paths of staged (Added/Modified/Renamed/Copied) files — exclude Deleted.
staged_files() {
  git diff --cached --name-only --diff-filter=ACMR "$@"
}

# -------- 0. Nothing private may ride an scani-oss-bound commit --------
#
# SC-569. Checking out a public-mirror branch inside a private worktree deletes
# the per-app `.gitignore` files, because they are tracked private files — so
# local build output whose only ignore rule lived there stops being ignored and
# a `git add -A` a second later takes files that were untrackable a moment
# before. Measured: nine of them, several carrying deployment identity. The
# paths are in the private commit rather than here, for the same reason the
# guard exists.
#
# First, and before the expensive checks, so a refusal is immediate.
#
# It is a REFUSAL on any non-zero status, including the script's exit 9, which
# means it could not tell whether this branch is bound for the mirror. "Could
# not tell" costs one `git fetch upstream`; treating it as a pass is how a
# guard becomes decoration in the one state where it cannot see.
if [ -f scripts/check-oss-bound-paths.ts ]; then
  if ! bun scripts/check-oss-bound-paths.ts; then
    fail "staged paths that cannot travel to MGrin/scani-oss"
  fi
else
  # Says so rather than passing quietly: on a branch predating SC-569 the
  # check genuinely does not exist, and a silent skip reads like a clean run.
  note "scripts/check-oss-bound-paths.ts is not in this tree; OSS-boundary check NOT run"
fi

# -------- 0b. Nothing internal may ride inside a file that legitimately travels --------
#
# SC-598. The check above answers ROUTING — which files may go — and says
# nothing about what is inside one that may. The hazard that leaves is an
# oss-eligible file, correctly pushed, whose COMMENTS carry an internal board
# key, an agent session id, an internal host or a machine-local path. That is
# not hypothetical: a mirror-bound draft carried a board key and two session
# ids, and the only thing between it and the public repo was somebody checking
# precedent by hand.
#
# It cannot be keyed on the classifier for the same two reasons the check
# above cannot be, and one more of its own: the classifier is private-only, so
# from a mirror-bound checkout it does not run at all. This one has no private
# imports and answers in both repositories — including in scani-oss itself,
# where there is no `upstream` remote and every commit is public by definition.
#
# A REFUSAL on any non-zero status, exit 9 included, on the same reasoning:
# "could not tell which repo this is for" is not a pass.
if [ -f scripts/check-oss-internal-refs.ts ]; then
  if ! bun scripts/check-oss-internal-refs.ts; then
    fail "staged content carries references that cannot travel to MGrin/scani-oss"
  fi
else
  note "scripts/check-oss-internal-refs.ts is not in this tree; internal-reference check NOT run"
fi

# -------- 1. Biome lint (staged files only, fast) --------

biome_relevant=$(staged_files -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.jsonc' || true)
if [ -n "$biome_relevant" ]; then
  note "biome check --staged"
  if ! bunx --bun @biomejs/biome@2.4.12 check --staged --no-errors-on-unmatched; then
    fail "biome check reported errors"
  fi
  ok "biome clean"
else
  note "no lintable files staged; skipping biome"
fi

# -------- 2. TypeScript type-check (full monorepo) --------
#
# Only triggered when TS/TSX files changed; the graph-based check has to
# be whole-project, so there's no point running it for docs/infra-only
# commits.
ts_relevant=$(staged_files -- '*.ts' '*.tsx' || true)
if [ -n "$ts_relevant" ]; then
  note "bun run type-check (full monorepo)"
  if ! bun run type-check >/dev/null 2>&1; then
    echo "${RED}type-check output:${RESET}" >&2
    bun run type-check >&2 || true
    fail "type-check errors"
  fi
  ok "type-check clean"
else
  note "no TS files staged; skipping type-check"
fi

# -------- 3. Syncpack (only when any package.json is staged) --------
#
# Catches version drift across the workspace: if two package.json files
# ever declare different versions of the same external dependency,
# syncpack fails here instead of at install time.

pkg_staged=$(staged_files -- '**/package.json' 'package.json' || true)
if [ -n "$pkg_staged" ]; then
  note "syncpack lint"
  if ! bun run deps:lint >/dev/null 2>&1; then
    echo "${RED}syncpack output:${RESET}" >&2
    bun run deps:lint >&2 || true
    echo "  Run: bun run deps:fix && git add package.json **/package.json" >&2
    fail "workspace dependencies out of sync"
  fi
  ok "dependencies in sync"
fi

# -------- 5. CI per-package filter list in sync with workspaces --------
#
# Triggered when any workspace package.json or the codegen-managed CI
# workflow changed. The auto:filters block in `.github/workflows/ci.yml`
# is generated from `packages/*/*/package.json`; staging drift fails CI
# server-side, so catch it here. Also runs when the codegen script itself
# is touched.

ci_relevant=$(staged_files -- 'packages/*/*/package.json' '.github/workflows/ci.yml' 'scripts/generate-ci-filters.ts' || true)
if [ -n "$ci_relevant" ]; then
  note "ci:gen:check"
  if ! bun run ci:gen:check >/dev/null 2>&1; then
    echo "${RED}ci:gen:check output:${RESET}" >&2
    bun run ci:gen:check >&2 || true
    echo "  Run: bun run ci:gen && git add .github/workflows/ci.yml" >&2
    fail "CI filter list out of sync with packages/*/*"
  fi
  ok "CI filters in sync"
fi

echo "${GREEN}✓ pre-commit passed${RESET}"
